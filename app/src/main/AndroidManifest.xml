<?xml version="1.0" encoding="utf-8"?>
<!-- legacy Xposed API 模块声明（参考 io.github.betterclock）：
     - 作用域只声明 SystemUI（模块只 hook 系统界面进程）
     - 入口类在 assets/xposed_init 中指定 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 该权限仅系统应用天然持有；本模块由用户通过 adb pm grant 显式授予（README 已说明），
         或在 SystemUI 进程内代写 Secure。lint 的 ProtectedPermissions 属预期行为。 -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 安全加固（F1）：SystemUI 内注册的配置接收器要求发送方持有本 signature 级权限。
         设置页 / 磁贴与本模块同签名，天然持有；其它已安装 App 无此签名 → 无法广播代写
         Secure/Global（开关显秒、改识别名、改小时色、置 AUTO_TIME）。 -->
    <permission
        android:name="io.github.kelebao.colorosclockseconds.permission.CONFIG"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.kelebao.colorosclockseconds.permission.CONFIG" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/module_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColorOSClockSeconds">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:value="com.android.systemui" />

        <activity
            android:name=".settings.ModuleSettingsActivity"
            android:exported="true"
            android:label="@string/module_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- 下拉通知栏磁贴：一键切换状态栏显秒。图标/文案来自应用资源。 -->
        <service
            android:name=".tile.SecondsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_seconds"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 桌面图标入口（TIME 别名）：默认启用，用户可在设置页「桌面显示图标」里关闭。
             用 activity-alias 而非直接给 Activity 加 LAUNCHER，是为了能独立启停、
             且不影响 LSPosed 管理器里的模块入口。标签固定为 TIME（品牌标识）。 -->
        <activity-alias
            android:name=".settings.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/launcher_label"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".settings.ModuleSettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
