<?xml version="1.0" encoding="utf-8"?>
<!-- legacy Xposed API 模块声明（参考 io.github.betterclock）：
     - 作用域只声明 SystemUI（模块只 hook 系统界面进程）
     - 入口类在 assets/xposed_init 中指定 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/module_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColorOSClockSeconds">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:value="com.android.systemui" />

        <activity
            android:name=".settings.ModuleSettingsActivity"
            android:exported="true"
            android:label="@string/module_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- 下拉通知栏磁贴：一键切换状态栏显秒。图标/文案来自应用资源。 -->
        <service
            android:name=".tile.SecondsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_seconds"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
