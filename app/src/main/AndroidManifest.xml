<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 用于设置页写入显秒/手势状态；普通应用需通过 adb 授予：
         adb shell pm grant io.github.kelebao.colorosclockseconds android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:label="@string/module_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColorOSClockSeconds">
        <activity
            android:name=".settings.ModuleSettingsActivity"
            android:exported="true"
            android:label="@string/module_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>
    </application>
</manifest>
